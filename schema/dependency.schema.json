{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://richology.cn/schemas/dependency.schema.json",
  "title": "Youth AI Growth Graph Relationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_id",
    "target_id",
    "type",
    "rationale",
    "contexts",
    "status",
    "version",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REL-[0-9]{4}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^(AI|BIZ|PRO|SOC)-[A-Z]{3}-[0-9]{3}$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^(AI|BIZ|PRO|SOC)-[A-Z]{3}-[0-9]{3}$"
    },
    "type": {
      "enum": ["requires", "supports", "related_to"]
    },
    "rationale": {
      "type": "string",
      "minLength": 20
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "status": {
      "enum": ["proposed", "draft", "stable", "deprecated"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
